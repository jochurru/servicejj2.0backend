# Backend Service JJ — variables de entorno (ejemplo)
# Copiá a `.env` y completá los valores.

API_KEY_SECRET=

# Debe coincidir con VITE_SERVICE_JJ_API_KEY del frontend.
# Gmail: usá una "Contraseña de aplicaciones" si tenés 2FA activado.
SMTP_USER=
SMTP_PASS=

# Quién recibe las consultas del formulario (por defecto en código: servicejjok@gmail.com)
CONTACT_TO_EMAIL=servicejjok@gmail.com

# Remitente From (si no definís SMTP_FROM, se usa SMTP_USER)
SMTP_FROM=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

CORS_ORIGIN=http://localhost:5173
PORT=5000
